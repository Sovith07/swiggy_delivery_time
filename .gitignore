# Data — file-level ignore so DVC .dvc pointer files can still be tracked
/data/*
!/data/external/
/data/external/*
!/data/external/.gitkeep

/data/raw/

/data/interim/*
!/data/interim/.gitkeep

/data/processed/*
!/data/processed/.gitkeep

/models/*
!/models/.gitkeep

# Env
.venv/
venv/
env/
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# OS
.DS_Store

# MLflow / DVC local artifacts
mlruns/
.dvc/cache
.dvc/tmp

# Jupyter
.ipynb_checkpoints
